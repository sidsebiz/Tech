{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/archive-grid",
	"title": "Archive grid",
	"category": "techvenza",
	"icon": "grid-view",
	"description": "Posts for the current archive (tag, date, series, author) with pagination.",
	"textdomain": "techvenza-core",
	"attributes": {
		"perPage": {
			"type": "number",
			"default": 9
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "perPage",
			"type": "number",
			"label": "Posts per page",
			"min": 3,
			"max": 30
		}
	]
}

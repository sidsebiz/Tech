{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/format-columns",
	"title": "Format columns",
	"category": "techvenza",
	"icon": "columns",
	"description": "Columns of stories by format (in-depth, analysis, guides…).",
	"textdomain": "techvenza-core",
	"attributes": {
		"columns": {
			"type": "array",
			"default": [
				{
					"title": "In-depth stories",
					"icon": "book",
					"types": [
						"deep-dive"
					],
					"orderby": "views"
				},
				{
					"title": "Expert analysis",
					"icon": "chart",
					"types": [
						"analysis",
						"opinion"
					],
					"orderby": "views"
				},
				{
					"title": "Evergreen guides",
					"icon": "compass",
					"types": [
						"guide"
					],
					"orderby": "views"
				}
			]
		},
		"count": {
			"type": "number",
			"default": 3
		},
		"surface": {
			"type": "string",
			"default": "default"
		},
		"spacing": {
			"type": "string",
			"default": "default"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "count",
			"type": "number",
			"label": "Stories per column",
			"min": 1,
			"max": 8
		},
		{
			"key": "columns",
			"type": "repeater",
			"label": "Columns",
			"panel": "Columns",
			"fields": [
				{
					"key": "title",
					"type": "text",
					"label": "Title"
				},
				{
					"key": "icon",
					"type": "icon",
					"label": "Icon"
				},
				{
					"key": "types",
					"type": "list",
					"label": "Formats"
				},
				{
					"key": "categories",
					"type": "categories",
					"label": "Only these categories"
				},
				{
					"key": "orderby",
					"type": "select",
					"label": "Order",
					"options": [
						{
							"value": "views",
							"label": "Most read"
						},
						{
							"value": "date",
							"label": "Newest"
						}
					]
				}
			],
			"addLabel": "Add column"
		},
		{
			"key": "surface",
			"type": "select",
			"label": "Background",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Page background"
				},
				{
					"value": "alt",
					"label": "Surface (white)"
				}
			]
		},
		{
			"key": "spacing",
			"type": "select",
			"label": "Vertical spacing",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Default"
				},
				{
					"value": "tight",
					"label": "Tight"
				},
				{
					"value": "none-top",
					"label": "No top padding"
				},
				{
					"value": "none-bottom",
					"label": "No bottom padding"
				}
			]
		}
	]
}

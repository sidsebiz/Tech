{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/related-posts",
	"title": "Related stories",
	"category": "techvenza",
	"icon": "admin-links",
	"description": "Stories sharing the category or tags of the current article.",
	"textdomain": "techvenza-core",
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Related stories"
		},
		"count": {
			"type": "number",
			"default": 3
		},
		"surface": {
			"type": "string",
			"default": "default"
		},
		"spacing": {
			"type": "string",
			"default": "default"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "heading",
			"type": "text",
			"label": "Heading"
		},
		{
			"key": "count",
			"type": "number",
			"label": "Stories",
			"min": 2,
			"max": 6
		},
		{
			"key": "surface",
			"type": "select",
			"label": "Background",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Page background"
				},
				{
					"value": "alt",
					"label": "Surface (white)"
				}
			]
		},
		{
			"key": "spacing",
			"type": "select",
			"label": "Vertical spacing",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Default"
				},
				{
					"value": "tight",
					"label": "Tight"
				},
				{
					"value": "none-top",
					"label": "No top padding"
				},
				{
					"value": "none-bottom",
					"label": "No bottom padding"
				}
			]
		}
	],
	"usesContext": [
		"postId",
		"postType"
	]
}

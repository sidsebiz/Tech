{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/popular",
	"title": "Popular this week",
	"category": "techvenza",
	"icon": "list-view",
	"description": "Most-read ranked list with an optional newsletter sidebar.",
	"textdomain": "techvenza-core",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": "Popular this week"
		},
		"heading": {
			"type": "string",
			"default": "Most read"
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"linkLabel": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"count": {
			"type": "number",
			"default": 6
		},
		"period": {
			"type": "string",
			"default": "7d"
		},
		"showNewsletter": {
			"type": "boolean",
			"default": true
		},
		"surface": {
			"type": "string",
			"default": "default"
		},
		"spacing": {
			"type": "string",
			"default": "default"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "eyebrow",
			"type": "text",
			"label": "Eyebrow",
			"panel": "Heading"
		},
		{
			"key": "heading",
			"type": "text",
			"label": "Heading",
			"panel": "Heading"
		},
		{
			"key": "description",
			"type": "textarea",
			"label": "Description",
			"panel": "Heading"
		},
		{
			"key": "linkLabel",
			"type": "text",
			"label": "Link label",
			"panel": "Heading"
		},
		{
			"key": "linkUrl",
			"type": "url",
			"label": "Link URL",
			"panel": "Heading"
		},
		{
			"key": "count",
			"type": "number",
			"label": "Stories",
			"min": 3,
			"max": 12
		},
		{
			"key": "period",
			"type": "select",
			"label": "Period",
			"options": [
				{
					"value": "24h",
					"label": "Last 24 hours"
				},
				{
					"value": "7d",
					"label": "Last 7 days"
				},
				{
					"value": "30d",
					"label": "Last 30 days"
				},
				{
					"value": "all",
					"label": "All time"
				}
			]
		},
		{
			"key": "showNewsletter",
			"type": "toggle",
			"label": "Newsletter sidebar"
		},
		{
			"key": "surface",
			"type": "select",
			"label": "Background",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Page background"
				},
				{
					"value": "alt",
					"label": "Surface (white)"
				}
			]
		},
		{
			"key": "spacing",
			"type": "select",
			"label": "Vertical spacing",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Default"
				},
				{
					"value": "tight",
					"label": "Tight"
				},
				{
					"value": "none-top",
					"label": "No top padding"
				},
				{
					"value": "none-bottom",
					"label": "No bottom padding"
				}
			]
		}
	]
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/partners",
	"title": "Partners",
	"category": "techvenza",
	"icon": "groups",
	"description": "Logos and links of partner companies managed in Editorial → Partners (link type and expiry per partner).",
	"textdomain": "techvenza-core",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": "Partners"
		},
		"heading": {
			"type": "string",
			"default": "Companies we work with"
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"count": {
			"type": "number",
			"default": 12
		},
		"showDescription": {
			"type": "boolean",
			"default": true
		},
		"surface": {
			"type": "string",
			"default": "default"
		},
		"spacing": {
			"type": "string",
			"default": "default"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "eyebrow",
			"type": "text",
			"label": "Eyebrow"
		},
		{
			"key": "heading",
			"type": "text",
			"label": "Heading"
		},
		{
			"key": "description",
			"type": "textarea",
			"label": "Description"
		},
		{
			"key": "count",
			"type": "number",
			"label": "Maximum partners",
			"min": 1,
			"max": 48
		},
		{
			"key": "showDescription",
			"type": "toggle",
			"label": "Show descriptions"
		},
		{
			"key": "surface",
			"type": "select",
			"label": "Background",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Page background"
				},
				{
					"value": "alt",
					"label": "Surface (white)"
				}
			]
		},
		{
			"key": "spacing",
			"type": "select",
			"label": "Vertical spacing",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Default"
				},
				{
					"value": "tight",
					"label": "Tight"
				},
				{
					"value": "none-top",
					"label": "No top padding"
				},
				{
					"value": "none-bottom",
					"label": "No bottom padding"
				}
			]
		}
	],
	"tvHint": "Add, order and expire partners in Editorial → Partners."
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/forgot-form",
	"title": "Forgot password form",
	"category": "techvenza",
	"icon": "unlock",
	"description": "Requests a password reset email.",
	"textdomain": "techvenza-core",
	"attributes": {
		"sideTitle": {
			"type": "string",
			"default": "Locked out? It happens."
		},
		"sideText": {
			"type": "string",
			"default": "Enter your email and we will send a secure link to reset your password."
		},
		"heading": {
			"type": "string",
			"default": "Forgot your password?"
		},
		"intro": {
			"type": "string",
			"default": "Enter the email you use for Techvenza."
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "heading",
			"type": "text",
			"label": "Heading",
			"panel": "Content"
		},
		{
			"key": "intro",
			"type": "textarea",
			"label": "Intro",
			"panel": "Content"
		},
		{
			"key": "sideTitle",
			"type": "text",
			"label": "Side panel title",
			"panel": "Side panel"
		},
		{
			"key": "sideText",
			"type": "textarea",
			"label": "Side panel text",
			"panel": "Side panel"
		}
	],
	"viewScript": "techvenza-forms"
}

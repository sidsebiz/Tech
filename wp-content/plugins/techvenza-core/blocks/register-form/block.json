{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/register-form",
	"title": "Registration form",
	"category": "techvenza",
	"icon": "id",
	"description": "Reader registration with email verification.",
	"textdomain": "techvenza-core",
	"attributes": {
		"sideTitle": {
			"type": "string",
			"default": "Read smarter. Follow what matters."
		},
		"sideText": {
			"type": "string",
			"default": "A free account lets you save stories, follow topics and apply to become a contributor."
		},
		"heading": {
			"type": "string",
			"default": "Create your account"
		},
		"intro": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "heading",
			"type": "text",
			"label": "Heading",
			"panel": "Content"
		},
		{
			"key": "intro",
			"type": "textarea",
			"label": "Intro",
			"panel": "Content"
		},
		{
			"key": "sideTitle",
			"type": "text",
			"label": "Side panel title",
			"panel": "Side panel"
		},
		{
			"key": "sideText",
			"type": "textarea",
			"label": "Side panel text",
			"panel": "Side panel"
		}
	],
	"viewScript": "techvenza-forms"
}

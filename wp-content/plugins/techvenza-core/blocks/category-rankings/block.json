{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/category-rankings",
	"title": "Trending by category",
	"category": "techvenza",
	"icon": "chart-bar",
	"description": "Top stories per category, side by side.",
	"textdomain": "techvenza-core",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": "By category"
		},
		"heading": {
			"type": "string",
			"default": "Trending by category"
		},
		"categories": {
			"type": "array",
			"default": [
				"ai",
				"software",
				"cybersecurity",
				"business"
			]
		},
		"count": {
			"type": "number",
			"default": 3
		},
		"surface": {
			"type": "string",
			"default": "default"
		},
		"spacing": {
			"type": "string",
			"default": "default"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "eyebrow",
			"type": "text",
			"label": "Eyebrow"
		},
		{
			"key": "heading",
			"type": "text",
			"label": "Heading"
		},
		{
			"key": "categories",
			"type": "categories",
			"label": "Categories"
		},
		{
			"key": "count",
			"type": "number",
			"label": "Stories each",
			"min": 1,
			"max": 6
		},
		{
			"key": "surface",
			"type": "select",
			"label": "Background",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Page background"
				},
				{
					"value": "alt",
					"label": "Surface (white)"
				}
			]
		},
		{
			"key": "spacing",
			"type": "select",
			"label": "Vertical spacing",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Default"
				},
				{
					"value": "tight",
					"label": "Tight"
				},
				{
					"value": "none-top",
					"label": "No top padding"
				},
				{
					"value": "none-bottom",
					"label": "No bottom padding"
				}
			]
		}
	]
}

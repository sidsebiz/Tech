{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/editor-note",
	"title": "Editor's note",
	"category": "techvenza",
	"icon": "format-quote",
	"description": "Serif pull note with attribution.",
	"textdomain": "techvenza-core",
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"attribution": {
			"type": "string",
			"default": ""
		},
		"surface": {
			"type": "string",
			"default": "default"
		},
		"spacing": {
			"type": "string",
			"default": "default"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "text",
			"type": "textarea",
			"label": "Note"
		},
		{
			"key": "attribution",
			"type": "text",
			"label": "Attribution"
		},
		{
			"key": "surface",
			"type": "select",
			"label": "Background",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Page background"
				},
				{
					"value": "alt",
					"label": "Surface (white)"
				}
			]
		},
		{
			"key": "spacing",
			"type": "select",
			"label": "Vertical spacing",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Default"
				},
				{
					"value": "tight",
					"label": "Tight"
				},
				{
					"value": "none-top",
					"label": "No top padding"
				},
				{
					"value": "none-bottom",
					"label": "No bottom padding"
				}
			]
		}
	]
}

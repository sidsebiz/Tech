{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/category-latest",
	"title": "Category latest",
	"category": "techvenza",
	"icon": "grid-view",
	"description": "Paginated latest stories in the category with subcategory filter.",
	"textdomain": "techvenza-core",
	"attributes": {
		"perPage": {
			"type": "number",
			"default": 6
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "perPage",
			"type": "number",
			"label": "Per page",
			"min": 3,
			"max": 24
		}
	],
	"viewScript": "techvenza-live"
}

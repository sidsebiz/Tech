{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techvenza/faq",
	"title": "FAQ",
	"category": "techvenza",
	"icon": "editor-help",
	"description": "Accordion of questions and answers with FAQPage structured data.",
	"textdomain": "techvenza-core",
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Frequently asked questions"
		},
		"items": {
			"type": "array",
			"default": []
		},
		"narrow": {
			"type": "boolean",
			"default": true
		},
		"surface": {
			"type": "string",
			"default": "default"
		},
		"spacing": {
			"type": "string",
			"default": "default"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true
	},
	"editorScript": "techvenza-blocks-editor",
	"render": "file:./render.php",
	"tvControls": [
		{
			"key": "heading",
			"type": "text",
			"label": "Heading"
		},
		{
			"key": "narrow",
			"type": "toggle",
			"label": "Narrow width"
		},
		{
			"key": "items",
			"type": "repeater",
			"label": "Questions",
			"panel": "Questions",
			"fields": [
				{
					"key": "q",
					"type": "text",
					"label": "Question"
				},
				{
					"key": "a",
					"type": "textarea",
					"label": "Answer"
				}
			],
			"addLabel": "Add question"
		},
		{
			"key": "surface",
			"type": "select",
			"label": "Background",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Page background"
				},
				{
					"value": "alt",
					"label": "Surface (white)"
				}
			]
		},
		{
			"key": "spacing",
			"type": "select",
			"label": "Vertical spacing",
			"panel": "Layout",
			"options": [
				{
					"value": "default",
					"label": "Default"
				},
				{
					"value": "tight",
					"label": "Tight"
				},
				{
					"value": "none-top",
					"label": "No top padding"
				},
				{
					"value": "none-bottom",
					"label": "No bottom padding"
				}
			]
		}
	]
}

<?xml version="1.0"?>
<ruleset name="Techvenza">
	<description>WordPress Coding Standards for the Techvenza theme and plugin.</description>
	<!-- Only the Techvenza theme and plugin live in wp-content/ in this repository. -->
	<file>wp-content</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="8.2-"/>
	<!-- Warnings are reported (and annotated in CI) but only errors fail the build. -->
	<config name="ignore_warnings_on_exit" value="1"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress">
		<!-- PSR-4 class file names are used in the plugin's src/ directory. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<!-- Custom tables are queried with $wpdb->prepare(); caching is handled at a higher level. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>
		<!-- Namespaced action/filter names (techvenza/...) are used deliberately; see docs/DECISIONS.md. -->
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="tv_review_posts"/>
				<element value="tv_approve_posts"/>
				<element value="tv_publish_posts"/>
				<element value="tv_manage_applications"/>
				<element value="tv_manage_authors"/>
				<element value="tv_manage_newsletter"/>
				<element value="tv_manage_messages"/>
				<element value="tv_manage_seo"/>
				<element value="tv_manage_settings"/>
				<element value="tv_view_analytics"/>
				<element value="tv_use_portal"/>
				<element value="tv_apply"/>
			</property>
		</properties>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="techvenza"/>
				<element value="techvenza-core"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="techvenza"/>
				<element value="Techvenza"/>
			</property>
		</properties>
	</rule>
</ruleset>
